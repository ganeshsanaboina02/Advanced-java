import java.sql.*;

public class classstudentjdbcapp {

    public static void main(String[] args) {

        String url = "jdbc:mysql://localhost:3306/testdb";
        String user = "testuser";
        String password = "testpass";

        try {
            // Load MySQL JDBC Driver (optional for JDBC 4.0+)
            Class.forName("com.mysql.cj.jdbc.Driver");

            try (Connection con = DriverManager.getConnection(url, user, password);
                 Statement stmt = con.createStatement()) {

                // Create Student table if it doesn't exist
                String createTable = "CREATE TABLE IF NOT EXISTS Student ("
                        + "ROLLNO INT PRIMARY KEY, "
                        + "NAME VARCHAR(50), "
                        + "ADDRESS VARCHAR(100))";

                stmt.executeUpdate(createTable);

                // Delete existing records
                stmt.executeUpdate("DELETE FROM Student");

                // Insert initial records
                stmt.executeUpdate("INSERT INTO Student VALUES (1, 'RAVI', 'HYDERABAD')");
                stmt.executeUpdate("INSERT INTO Student VALUES (2, 'SITA', 'CHENNAI')");

                System.out.println("Initial Records:");
                displayRecords(stmt);

                // Insert new records
                stmt.executeUpdate("INSERT INTO Student VALUES (3, 'RAHUL', 'BENGALURU')");
                stmt.executeUpdate("INSERT INTO Student VALUES (4, 'PRIYA', 'MUMBAI')");

                System.out.println("\nAfter Inserting Two New Records:");
                displayRecords(stmt);

                // Update a record
                stmt.executeUpdate("UPDATE Student SET ADDRESS='DELHI' WHERE ROLLNO=2");

                System.out.println("\nAfter Updating Record (ROLLNO=2):");
                displayRecords(stmt);

                // Delete a record
                stmt.executeUpdate("DELETE FROM Student WHERE ROLLNO=1");

                System.out.println("\nAfter Deleting Record (ROLLNO=1):");
                displayRecords(stmt);
            }

        } catch (ClassNotFoundException e) {
            System.out.println("MySQL JDBC Driver not found.");
            e.printStackTrace();
        } catch (SQLException e) {
            System.out.println("Database Error.");
            e.printStackTrace();
        }
    }

    public static void displayRecords(Statement stmt) throws SQLException {

        String query = "SELECT * FROM Student";

        try (ResultSet rs = stmt.executeQuery(query)) {

            System.out.println("ROLLNO\tNAME\tADDRESS");

            while (rs.next()) {
                System.out.println(
                        rs.getInt("ROLLNO") + "\t" +
                        rs.getString("NAME") + "\t" +
                        rs.getString("ADDRESS"));
            }
        }
    }
}
